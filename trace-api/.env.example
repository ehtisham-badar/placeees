PORT=3000
DATABASE_URL=postgres://trace:trace@localhost:5432/trace
JWT_SECRET=replace-with-at-least-32-random-characters
# Sign in with Apple: the iOS bundle id is the token audience
APPLE_BUNDLE_ID=app.trace.mobile
# Google sign-in: comma-separated OAuth client ids (iOS, Android, web)
GOOGLE_CLIENT_IDS=
# Enables POST /v1/auth/dev for local development only
ALLOW_DEV_LOGIN=true
# Cloudflare R2 (S3-compatible). Media endpoints return media_unavailable when unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trace-media
# Optional: enables OpenAI moderation. Without it a local word filter is used.
OPENAI_API_KEY=
# Push: APNs token auth (iOS) and FCM HTTP v1 (Android). Pushes are skipped when unset.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Background jobs (capsule notifications). Disable on extra API replicas if you like.
RUN_JOBS=true
# F-17 integrity: off | report | enforce
INTEGRITY_MODE=off
APPLE_TEAM_ID=
ANDROID_PACKAGE=app.trace.mobile
ANDROID_CERT_SHA256=
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# F-05 admin (long random string). Unset disables /admin.
ADMIN_TOKEN=
# F-16 venue links
PUBLIC_WEB_URL=https://trace.app
APP_STORE_URL=
PLAY_STORE_URL=
# Development only: store uploads on this machine when R2 isn't set (photos, voice) and the URL
# phones use to reach this API.
LOCAL_MEDIA_DIR=
PUBLIC_API_URL=
